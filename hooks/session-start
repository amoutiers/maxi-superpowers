#!/usr/bin/env bash
# SessionStart hook for maxi plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-maxi content
using_maxi_content=$(cat "${PLUGIN_ROOT}/skills/using-maxi/SKILL.md" 2>&1 || echo "Error reading using-maxi skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_maxi_escaped=$(escape_for_json "$using_maxi_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have maxi.\n\n**Below is the full content of your 'maxi:using-maxi' skill - your introduction to the maxi spec-driven pipeline. For all other maxi skills, use the 'Skill' tool:**\n\n${using_maxi_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection in platform-specific format.
# This script may be invoked by different platforms, each expecting a different JSON shape:
#   - Claude Code: hookSpecificOutput.additionalContext (via hooks.json + CLAUDE_PLUGIN_ROOT)
#   - Cursor: additional_context top-level (if Cursor loads this via CURSOR_PLUGIN_ROOT)
#   - Copilot CLI / unknown: additionalContext top-level (SDK standard)
# Note: hooks.json only registers this hook for Claude Code. Cursor/Copilot support
# requires each platform to load the script via its own hook mechanism.
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
