#!/usr/bin/env bash
# SessionStart hook for maxi plugin
#
# One unified hook for all harnesses that run a session-start shell hook
# (Claude Code, Antigravity, Cursor, Copilot CLI, Muse, Qwen). Codex and OpenCode use
# their own discovery mechanisms and do not call this hook.
#
# Output format is selected by environment:
#   - Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT) → additional_context
#   - Muse sets MUSE_PLUGIN_ROOT and Qwen sets QWEN_PROJECT_DIR → hookSpecificOutput.additionalContext
#   - Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI → hookSpecificOutput.additionalContext
#   - Copilot CLI (sets COPILOT_CLI=1) or unknown → additionalContext (SDK standard)

set -euo pipefail

# Use builtins before a sibling startup hook has repaired PATH.
case "$0" in
  */*|*\\*) SCRIPT_DIR="$(cd "${0%[/\\]*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Only inject in maxi projects — skip in projects without docs/maxi/.
if [ ! -d "$PWD/docs/maxi" ]; then
  exit 0
fi

# Read using-maxi content
skill_md="${PLUGIN_ROOT}/skills/using-maxi/SKILL.md"
if [ -r "$skill_md" ]; then
  using_maxi_content="$(<"$skill_md")"
else
  using_maxi_content="Error reading using-maxi skill"
fi

# Escape string for JSON embedding using bash parameter substitution.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_maxi_escaped=$(escape_for_json "$using_maxi_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have maxi.\n\n**Below is the full content of your 'maxi:using-maxi' skill - your introduction to the maxi spec-driven pipeline. For all other maxi skills, use the 'Skill' tool:**\n\n${using_maxi_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection as JSON.
# The bootstrap preamble (the <EXTREMELY_IMPORTANT> block above) MUST stay
# byte-identical across this hook and .opencode/plugins/maxi.js — guarded by
# tests/check-bootstrap-parity.sh. Edit both together.
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# Let cat absorb Windows EPIPE when available; empty PATH still uses printf.
emit_json() {
  # shellcheck disable=SC2059 # callers pass literal format strings
  if command -v cat >/dev/null 2>&1; then
    printf "$@" | cat
  else
    printf "$@"
  fi
}

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  emit_json '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${MUSE_PLUGIN_ROOT:-}" ] || [ -n "${QWEN_PROJECT_DIR:-}" ] || { [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; }; then
  # Muse and Qwen take the native nested shape even when Claude markers coexist.
  emit_json '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  emit_json '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
